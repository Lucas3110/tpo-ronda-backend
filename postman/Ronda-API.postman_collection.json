    {
      "name": "1 · Registro y OTP",
      "item": [
        {
          "name": "POST /auth/registro",
          "id": "a2cc51b1-4cc7-28b5-4fdb-f64ff1fd6e1f",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea la cuenta y envía el primer código OTP.\n\nGuarda automáticamente el código en la variable {{codigo}} (sólo funciona con OTP_EXPOSE_IN_RESPONSE=true).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"nombre\": \"Lucas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "if (pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    if (data.codigoDesarrollo) pm.collectionVariables.set(\"codigo\", data.codigoDesarrollo);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/otp/enviar — reenviar (REGISTRO)",
          "id": "90cd2bf7-0427-f17b-c0fc-c7d2dba0f020",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/otp/enviar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "enviar"
              ]
            },
            "description": "Reenvía el código de registro. Si lo mandás dos veces seguidas responde 429 OTP_COOLDOWN: es el anti-spam de 60 segundos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"proposito\": \"REGISTRO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "if (pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    if (data.codigoDesarrollo) pm.collectionVariables.set(\"codigo\", data.codigoDesarrollo);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/otp/verificar — confirmar cuenta",
          "id": "889ae908-1ccb-3a6e-8c7a-952028f5a739",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/otp/verificar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "verificar"
              ]
            },
            "description": "Valida el código, marca el email como verificado y devuelve el token. Guarda el token en {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"codigo\": \"{{codigo}}\",\n  \"proposito\": \"REGISTRO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "if (pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "}"
                ]
              }
            }
          ]
        }
