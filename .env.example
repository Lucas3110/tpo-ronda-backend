# ---------- Servidor ----------
PORT=3000
NODE_ENV=development

# ---------- Base de datos ----------
# Valores por defecto pensados para XAMPP (MariaDB): usuario root, sin contrasena.
# Si usas MySQL Server instalado aparte, poné acá tu contrasena de root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ronda

# ---------- JWT ----------
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ---------- OTP ----------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# En true la API devuelve el codigo en la respuesta (SOLO desarrollo/demo).
# Es lo que permite que la coleccion de Postman guarde el codigo sola.
OTP_EXPOSE_IN_RESPONSE=true

# ---------- Mail ----------
# console = imprime el codigo en la terminal (no necesita configurar nada)
# smtp    = manda mail de verdad (ver README para Gmail App Password)
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Ronda <no-reply@ronda.app>
